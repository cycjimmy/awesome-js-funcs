{
  "name": "@cycjimmy/awesome-js-funcs",
  "type": "module",
  "version": "4.0.11",
  "description": "Personal collection of javascript functions often used.",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/awesome-js-funcs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/awesome-js-funcs.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/awesome-js-funcs/issues"
  },
  "keywords": [
    "collection",
    "javascript"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./array": "./dist/array/index.js",
    "./designPattern": "./dist/designPattern/index.js",
    "./dom": "./dist/dom/index.js",
    "./event": "./dist/event/index.js",
    "./function": "./dist/function/index.js",
    "./handheld": "./dist/handheld/index.js",
    "./judge": "./dist/judge/index.js",
    "./judgeBasic": "./dist/judgeBasic/index.js",
    "./math": "./dist/math/index.js",
    "./media": "./dist/media/index.js",
    "./object": "./dist/object/index.js",
    "./regExpression": "./dist/regExpression/index.js",
    "./seldom": "./dist/seldom/index.js",
    "./string": "./dist/string/index.js",
    "./typeConversion": "./dist/typeConversion/index.js",
    "./*": "./dist/*.js",
    "./*.js": "./dist/*.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "build": "trash .release && node tasks/copyFiles.js",
    "package": "npm run build && node tasks/handlePackageJson.js",
    "verify": "node tasks/verifyRelease.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cycjimmy/config-lib": "^3.2.1",
    "eslint": "^10.14.0",
    "fs-extra": "^11.2.0",
    "trash-cli": "^7.0.0"
  }
}
